# Required for chat, auto-routing, Mem0 OSS extraction/embeddings (Together OpenAI-compatible API)
TOGETHER_API_KEY=

# Optional: MongoDB for profiles + MCP server config persistence (falls back to apps/server/data/*.json)
MONGODB_URI=

# CORS / frontend URL (Vite default)
WEB_ORIGIN=http://localhost:5173

# Server port
PORT=3001

# Default chat models (Together API model id strings)
CHAT_MODEL_LOW=google/gemma-3n-E4B-it
CHAT_MODEL_MED=openai/gpt-oss-20b
CHAT_MODEL_HIGH=Qwen/Qwen3.5-9B

# Cheap model for complexity tier classification (auto mode)
CLASSIFIER_MODEL=google/gemma-3n-E4B-it

# Mem0 OSS (`mem0ai/oss`) — LLM + embedder via Together; dimension must match embedding model
MEM0_EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
MEM0_EMBEDDING_DIMS=1024
MEM0_LLM_MODEL=google/gemma-3n-E4B-it

# Mem0 OSS SQLite history (vectors default to in-memory unless you configure Qdrant/Redis in Mem0)
MEM0_HISTORY_DB=./apps/server/data/mem0-history.db

# Agent loop
MAX_TOOL_ROUNDS=8

# Server logging (Pino). Realtime: stdout. Optional file: JSON lines appended.
# LOG_LEVEL=info
# LOG_PRETTY=1
# LOG_FILE=./apps/server/data/helper-server.log
