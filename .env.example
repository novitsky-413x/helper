# ─────────────────────────────────────────────────
# HELPER — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────

# Required: Together.ai API key (chat, embeddings, Mem0)
TOGETHER_API_KEY=

# Optional: MongoDB for profiles + MCP server config (falls back to JSON files)
MONGODB_URI=

# CORS / frontend origin (Vite default)
WEB_ORIGIN=http://localhost:5173

# Server port
PORT=3001

# ─── Models ────────────────────────────────────────
# Base model for chat orchestration
TOGETHER_BASE_MODEL=google/gemma-3n-E4B-it

# Optional: auto-routing tier models (if empty, uses base model for all)
# CHAT_MODEL_LOW=
# CHAT_MODEL_MED=
# CHAT_MODEL_HIGH=

# Classifier model for complexity routing
# CLASSIFIER_MODEL=google/gemma-3n-E4B-it

# ─── Mem0 OSS ─────────────────────────────────────
# Embedding model + dimensions
# MEM0_EMBEDDING_MODEL=
MEM0_EMBEDDING_DIMS=1024
# MEM0_LLM_MODEL=

# SQLite path for Mem0 history
MEM0_HISTORY_DB=./apps/server/data/mem0-history.db

# ─── Agent ─────────────────────────────────────────
# Max tool call rounds per request (streamText mode)
MAX_TOOL_ROUNDS=8

# ─── autoDream (memory consolidation) ─────────────
# Minimum hours between auto-dream runs (default: 6)
# DREAM_MIN_INTERVAL_HOURS=6

# Minimum completed agent sessions before triggering dream (default: 3)
# DREAM_MIN_SESSIONS=3

# ─── Model Evaluation ─────────────────────────────
# Evaluate model quality every N completed sessions (default: 5)
# EVAL_EVERY_N_SESSIONS=5

# ─── Logging ──────────────────────────────────────
# LOG_LEVEL=info
# LOG_PRETTY=1
# LOG_FILE=./apps/server/data/helper-server.log
